# vsce applies negations (!) after all ignores, so a broad "!dist/**" would
# override the *.map rule below. Only list exclusions here; everything not
# named is packaged.

.vscode/**
.vscode-test/**
node_modules/**
out/**
src/**
scripts/**
test/**
docs/**
prompts/**

esbuild.js
tsconfig.json
.gitignore
.gitattributes
.eslintrc*

**/*.ts
**/*.map
media/icon.svg
# README references these by absolute URL, so they need not ship.
media/screenshot-*.png
